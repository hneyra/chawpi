{
    "name": "simple-sample-web",
    "version": "0.1.0",
    "private": true,
    "description": "simple-sample web: @hneyra/core alone",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "lint": "prettier --check src index.html package.json tsconfig.json tsconfig.build.json vite.config.ts",
        "test": "vitest run",
        "build": "tsc -p tsconfig.build.json && vite build",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@hneyra/core": "*",
        "@hneyra/ui": "*",
        "@tanstack/react-query": "5.103.1",
        "i18next": "26.4.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-i18next": "17.0.14",
        "react-router": "8.4.0"
    },
    "devDependencies": {
        "@hneyra/testing": "*",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "24.10.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "jsdom": "30.1.0",
        "prettier": "3.8.2",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    }
}
